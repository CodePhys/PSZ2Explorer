<Window x:Class="PSZ2Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="PSZ2 Explorer" Height="700" Width="1100">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 10">
            <Button Content="Carica CSV..." Click="LoadCsv_Click" Margin="0 0 10 0"/>

            <TextBlock Text="Plot:" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <ComboBox x:Name="PlotSelector" Width="220"
                      SelectionChanged="PlotSelector_SelectionChanged">
                <ComboBoxItem Content="Istogramma redshift" Tag="HistZ" IsSelected="True"/>
                <ComboBoxItem Content="Istogramma masse SZ" Tag="HistMass"/>
                <ComboBoxItem Content="Massa vs redshift" Tag="ScatterMZ"/>
                <ComboBoxItem Content="Istogramma SNR" Tag="HistSnr"/>
            </ComboBox>

            <TextBlock Text="  SNR min:" VerticalAlignment="Center" Margin="20 0 5 0"/>
            <TextBox x:Name="SnrMinTextBox" Width="50" Text="6"
                     TextChanged="SnrMinTextBox_TextChanged"/>

            <TextBlock x:Name="SampleInfoTextBlock"
                       Margin="20 0 0 0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <oxy:PlotView x:Name="PlotView" Grid.Row="1" />
    </Grid>
</Window>
