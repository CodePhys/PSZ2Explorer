<Window x:Class="PSZ2Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="PSZ2 Explorer" Height="720" Width="1120"
        MinHeight="400" MinWidth="800"
        Background="#F5F5F5">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra comandi -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="14 12" Margin="0 0 0 12"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- Riga 1: Cataloghi + Grafico -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <!-- Cataloghi -->
                    <Border Background="#F0F4F8" CornerRadius="4" Padding="10 6" Margin="0 0 16 0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Carica catalogo..." Click="LoadCsv_Click" Padding="12 6" MinWidth="120"
                                    Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="Carica overlay..." Click="LoadOverlay_Click" Padding="12 6" MinWidth="110" Margin="8 0 0 0"
                                    ToolTip="Secondo catalogo (es. eROSITA, ACT) per Massa vs redshift"
                                    Cursor="Hand"/>
                            <TextBlock x:Name="OverlayLabel" Text="" VerticalAlignment="Center" Margin="10 0 0 0"
                                       Foreground="#607D8B" FontSize="12" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Fill="#E0E0E0" Margin="0 2 16 2"/>

                    <!-- Tipo grafico -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Grafico" VerticalAlignment="Center" Margin="0 0 8 0"
                                   FontWeight="SemiBold" Foreground="#37474F"/>
                        <ComboBox x:Name="PlotSelector" Width="240" Padding="8 5"
                                  SelectionChanged="PlotSelector_SelectionChanged"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Istogramma redshift" Tag="HistZ" IsSelected="True"/>
                            <ComboBoxItem Content="Istogramma masse SZ" Tag="HistMass"/>
                            <ComboBoxItem Content="Massa vs redshift" Tag="ScatterMZ"/>
                            <ComboBoxItem Content="Istogramma SNR" Tag="HistSnr"/>
                            <ComboBoxItem Content="Istogramma y5r500" Tag="HistY5"/>
                            <ComboBoxItem Content="y5r500 vs Massa" Tag="ScatterY5M"/>
                            <ComboBoxItem Content="Redshift vs y5r500" Tag="ScatterZY5"/>
                            <ComboBoxItem Content="Heatmap massa–redshift" Tag="HeatMapMZ"/>
                            <ComboBoxItem Content="Mappa celeste (Aitoff)" Tag="SkyMap"/>
                            <ComboBoxItem Content="Mappa RA–Dec–z (colore = z)" Tag="SkyMapZ"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Riga 2: Filtri e opzioni -->
                <StackPanel Orientation="Horizontal">
                    <Border Background="#EEF2F6" CornerRadius="4" Padding="10 6" Margin="0 0 12 0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SNR min" VerticalAlignment="Center" Margin="0 0 6 0"
                                       Foreground="#546E7A"/>
                            <TextBox x:Name="SnrMinTextBox" Width="44" Text="6" Padding="6 4"
                                     TextChanged="SnrMinTextBox_TextChanged"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="CosmologyOnlyCheckBox" Content="Solo campione cosmologico"
                              VerticalAlignment="Center" Margin="8 0 0 0"
                              Foreground="#37474F"
                              Checked="CosmologyOnlyCheckBox_Changed" Unchecked="CosmologyOnlyCheckBox_Changed"/>

                    <CheckBox x:Name="ComparableOverlayCheckBox" Content="Confrontabile (stesso range M–z)"
                              VerticalAlignment="Center" Margin="20 0 0 0"
                              Foreground="#37474F"
                              ToolTip="Overlay limitato allo stesso intervallo z e M del catalogo principale"
                              Checked="ComparableOverlayCheckBox_Changed" Unchecked="ComparableOverlayCheckBox_Changed"/>

                    <TextBlock x:Name="SampleInfoTextBlock" Margin="24 0 0 0" VerticalAlignment="Center"
                               Foreground="#455A64" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Area grafico -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <oxy:PlotView x:Name="PlotView" Background="White"/>
        </Border>
    </Grid>
</Window>
